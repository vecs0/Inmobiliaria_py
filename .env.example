# ============================================================
# InmobiliariaPY — variables de entorno (copiar a .env.local)
# NO commitear valores reales. Configurar las mismas en Vercel.
# ============================================================

# ── App ─────────────────────────────────────────────────────
# URL pública base (única fuente para redirects, emails, success_url de Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origen permitido para CORS de la API pública (por defecto NEXT_PUBLIC_APP_URL)
ALLOWED_ORIGIN=http://localhost:3000
# Tipo de cambio USD→PYG mostrado en la UI
NEXT_PUBLIC_USD_PYG_RATE=7800

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO servidor (webhooks, cron, API pública). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
# Firma del endpoint /api/stripe/webhook (Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# ── OpenAI (embeddings / búsqueda semántica) ────────────────
OPENAI_API_KEY=

# ── Resend (emails transaccionales) ─────────────────────────
RESEND_API_KEY=
# Remitente: dominio verificado en Resend
RESEND_FROM_EMAIL="InmobiliariaPY <no-reply@inmobiliariapy.com>"

# ── Cron / endpoints internos ───────────────────────────────
# Vercel Cron envía "Authorization: Bearer $CRON_SECRET" automáticamente.
# También protege /api/push/send. Generar con: openssl rand -hex 32
CRON_SECRET=

# ── Web Push (VAPID) ────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o URL de contacto
VAPID_SUBJECT=mailto:soporte@inmobiliariapy.com
